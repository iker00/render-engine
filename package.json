{
  "name": "react-form-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --coverage --exclude 'src/tests/dev-runtime/*-bundle.test.ts' --exclude '**/node_modules/**' --exclude '**/dist/**'",
    "test:watch": "vitest",
    "test:build": "vitest run src/tests/dev-runtime/dev-runtime-bundle.test.ts src/tests/dev-runtime/runtime-nodes-bundle.test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.17.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
