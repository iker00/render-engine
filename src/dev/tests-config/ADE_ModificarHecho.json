{
  "tokens": {
    "token": {
      "value": "#bearer_token#"
    }
  },
  "api": {
    "obtenerDatosFormularioModificacionHecho": {
      "method": "POST",
      "endpoint": "/api/ss/Ade/v1/operations/C4D9E836-4B0A-5F9C-A3B2-7E8F0B1D4C62/ObtenerDatosFormularioModificacionHecho",
      "headers": {
        "Authorization": "Bearer {{tokens.token.value}}"
      },
      "body": {
        "IdHecho": "params.hechoId"
      }
    },
    "modificarHecho": {
      "method": "POST",
      "endpoint": "/api/ss/Ade/v1/operations/F3A8B725-3C9D-4E8A-B2F1-6D7E9A0C3B51/ModificarHecho",
      "headers": {
        "Authorization": "Bearer {{tokens.token.value}}"
      },
      "body": {
        "ModificarHechoEntradaDTO": {
          "IdHecho": "params.hechoId",
          "Lugar": "forms.modificarHecho.lugar",
          "FechaHecho": "forms.modificarHecho.fechaHecho",
          "HoraHecho": "forms.modificarHecho.horaHecho",
          "IdTipoHecho": "forms.modificarHecho.idTipoHecho",
          "IdOrigenHecho": "forms.modificarHecho.idOrigenHecho",
          "ResumenHecho": "forms.modificarHecho.resumenHecho",
          "Agente": "forms.modificarHecho.agente",
          "Agente1": "forms.modificarHecho.agente1"
        }
      }
    }
  },
  "pages": [
    {
      "id": "modificar-hecho",
      "preloads": [
        {
          "obtenerDatosFormularioModificacionHecho": {}
        }
      ],
      "layout": [
        {
          "type": "container",
          "props": {
            "direction": "column",
            "gap": "lg"
          },
          "children": [
            {
              "type": "heading",
              "props": {
                "text": "Informe de actividad",
                "level": 1
              }
            },
            {
              "type": "heading",
              "props": {
                "text": "Modificar hecho",
                "level": 2
              }
            },
            {
              "type": "container",
              "props": {
                "variant": "card",
                "gap": "md"
              },
              "queryStateFeedback": {
                "query": "obtenerDatosFormularioModificacionHecho",
                "states": {
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "skeleton",
                        "props": {
                          "variant": "rect",
                          "height": "400px"
                        }
                      }
                    ]
                  },
                  "error": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "alert",
                        "props": {
                          "title": "Error al cargar los datos del hecho.",
                          "message": "{{queries.obtenerDatosFormularioModificacionHecho.error.message}}",
                          "type": "danger"
                        }
                      }
                    ]
                  }
                }
              },
              "children": [
                {
                  "type": "paragraph",
                  "props": {
                    "text": "* Datos obligatorios"
                  }
                },
                {
                  "type": "form",
                  "id": "modificarHecho",
                  "submitAction": {
                    "type": "executeOperation",
                    "operationName": "modificarHecho"
                  },
                  "children": [
                    {
                      "type": "input",
                      "props": {
                        "fieldId": "lugar",
                        "label": "Lugar",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.Lugar",
                        "validations": {
                          "required": true
                        }
                      }
                    },
                    {
                      "type": "input",
                      "props": {
                        "fieldId": "fechaHecho",
                        "label": "Fecha hecho",
                        "inputType": "date",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.FechaHecho",
                        "validations": {
                          "required": true
                        }
                      }
                    },
                    {
                      "type": "input",
                      "props": {
                        "fieldId": "horaHecho",
                        "label": "Hora hecho",
                        "placeholder": "HH:mm",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.HoraHecho",
                        "validations": {
                          "required": true,
                          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$"
                        }
                      }
                    },
                    {
                      "type": "select",
                      "props": {
                        "fieldId": "idTipoHecho",
                        "label": "Tipo de hecho",
                        "placeholder": "Seleccione un tipo",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.IdTipoHecho",
                        "items": {
                          "source": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.TiposHechoDTO",
                          "label": "Nombre",
                          "value": "Id"
                        },
                        "validations": {
                          "required": true
                        }
                      }
                    },
                    {
                      "type": "select",
                      "props": {
                        "fieldId": "idOrigenHecho",
                        "label": "Origen hecho",
                        "placeholder": "Seleccione un origen",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.IdOrigenHecho",
                        "items": {
                          "source": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.OrigenesHechoDTO",
                          "label": "Nombre",
                          "value": "Id"
                        },
                        "validations": {
                          "required": true
                        }
                      }
                    },
                    {
                      "type": "textarea",
                      "props": {
                        "fieldId": "resumenHecho",
                        "label": "Resumen",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.ResumenHecho",
                        "validations": {
                          "required": true
                        }
                      }
                    },
                    {
                      "type": "input",
                      "props": {
                        "fieldId": "agente",
                        "label": "Agente",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.Agente",
                        "validations": {
                          "required": true
                        }
                      }
                    },
                    {
                      "type": "input",
                      "props": {
                        "fieldId": "agente1",
                        "label": "Agente 1",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionHecho.data.DatosFormularioModificacionHechoSalidaDTO.HechoFormularioDTO.Agente1"
                      }
                    },
                    {
                      "type": "button",
                      "props": {
                        "label": "Guardar →",
                        "color": "primary",
                        "icon": "save"
                      }
                    }
                  ]
                },
                {
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": "sm"
                  },
                  "queryStateFeedback": {
                    "query": "modificarHecho",
                    "states": {
                      "idle": {
                        "mode": "hide"
                      },
                      "loading": {
                        "mode": "fallback",
                        "fallback": [
                          {
                            "type": "skeleton",
                            "props": {
                              "variant": "rect",
                              "height": "8"
                            }
                          }
                        ]
                      },
                      "success": {
                        "mode": "fallback",
                        "fallback": [
                          {
                            "type": "alert",
                            "props": {
                              "title": "Cambios guardados",
                              "message": "Los cambios se han guardado correctamente.",
                              "type": "success"
                            }
                          },
                          {
                            "type": "link",
                            "props": {
                              "label": "Ver ficha",
                              "action": {
                                "type": "navigateTo",
                                "pageId": "ficha-hecho",
                                "params": {
                                  "hechoId": "params.hechoId"
                                }
                              }
                            }
                          }
                        ]
                      },
                      "error": {
                        "mode": "fallback",
                        "fallback": [
                          {
                            "type": "alert",
                            "props": {
                              "title": "No se pudo guardar",
                              "message": "{{queries.modificarHecho.error.message}}",
                              "type": "danger"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "initialPage": "modificar-hecho"
}
