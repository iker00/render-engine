{
  "tokens": {
    "token": {
      "value": "#bearer_token#"
    }
  },
  "api": {
    "buscarBanda": {
      "method": "POST",
      "endpoint": "https://pre-frontapi.pamplona.es/ss/Ade/v1/operations/B9E4A731-2D6C-4F8A-A5B1-7C3D9E2F4A80/BuscarBanda",
      "headers": {
        "Authorization": "Bearer {{tokens.token.value}}"
      },
      "body": {
        "BuscarBandaEntradaDTO": {
          "Nombre": "forms.searchBanda.nombre",
          "Descripcion": "forms.searchBanda.descripcion"
        }
      }
    }
  },
  "pages": [
    {
      "id": "buscar-banda",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Búsqueda de bandas",
            "level": 1
          }
        },
        {
          "type": "form",
          "id": "searchBanda",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "buscarBanda"
          },
          "children": [
            {
              "type": "input",
              "props": {
                "fieldId": "nombre",
                "label": "Nombre"
              }
            },
            {
              "type": "input",
              "props": {
                "fieldId": "descripcion",
                "label": "Descripción"
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Buscar",
                "icon": "search"
              }
            }
          ]
        },
        {
          "type": "heading",
          "props": {
            "text": "Resultados",
            "level": 1
          },
          "queryStateFeedback": {
            "query": "buscarBanda",
            "states": {
              "idle": {
                "mode": "hide"
              }
            }
          }
        },
        {
          "type": "repeater",
          "props": {
            "items": {
              "source": "queries.buscarBanda.data.BuscarBandaSalidaDTO.ResultadosBusquedaBandaDTO",
              "key": "Id"
            },
            "template": [
              {
                "type": "container",
                "props": {
                  "variant": "card",
                  "direction": "column",
                  "gap": "sm"
                },
                "children": [
                  {
                    "type": "stat",
                    "props": {
                      "label": "Nombre",
                      "value": "{{item.Nombre}}"
                    }
                  },
                  {
                    "type": "stat",
                    "props": {
                      "label": "Descripción",
                      "value": "{{item.Descripcion}}"
                    }
                  },
                  {
                    "type": "link",
                    "props": {
                      "label": "Ver ficha",
                      "href": "/carpetaciudadana/detallegenerico.aspx?tram=427&sec=18#/?bandaId={{item.Id}}"
                    }
                  }
                ]
              }
            ]
          },
          "queryStateFeedback": {
            "query": "buscarBanda",
            "states": {
              "idle": {
                "mode": "hide"
              },
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Cargando..."
                    }
                  }
                ]
              },
              "error": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "alert",
                    "props": {
                      "message": "Error al cargar los datos.",
                      "type": "danger"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "initialPage": "buscar-banda"
}
