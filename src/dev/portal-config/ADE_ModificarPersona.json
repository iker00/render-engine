{
  "tokens": {
    "token": {
      "value": "#bearer_token#"
    }
  },
  "api": {
    "obtenerDatosFormularioModificacionPersona": {
      "method": "POST",
      "endpoint": "https://pre-frontapi.pamplona.es/ss/Ade/v1/operations/A7B2C914-5E8F-4D1A-9C3B-8F0E2A6D4B71/ObtenerDatosFormularioModificacionPersona",
      "headers": {
        "Authorization": "Bearer {{tokens.token.value}}"
      },
      "body": {
        "IdPersona": "params.personaId"
      }
    },
    "modificarPersona": {
      "method": "POST",
      "endpoint": "https://pre-frontapi.pamplona.es/ss/Ade/v1/operations/B8C3D025-6F9A-4E2B-AD4C-9A1F3B7E5C82/ModificarPersona",
      "headers": {
        "Authorization": "Bearer {{tokens.token.value}}"
      },
      "body": {
        "ModificarPersonaEntradaDTO": {
          "IdPersona": "params.personaId",
          "Nombre": "forms.modificarPersona.nombre",
          "Apellido1": "forms.modificarPersona.apellido1",
          "Apellido2": "forms.modificarPersona.apellido2",
          "Apodo": "forms.modificarPersona.apodo",
          "Email": "forms.modificarPersona.email",
          "FechaNacimiento": "forms.modificarPersona.fechaNacimiento",
          "IdPaisNacimiento": "forms.modificarPersona.idPaisNacimiento",
          "Nacionalidad": "forms.modificarPersona.nacionalidad",
          "Nacionalidad2": "forms.modificarPersona.nacionalidad2",
          "IdTipoDocumento": "forms.modificarPersona.idTipoDocumento",
          "DocIdent": "forms.modificarPersona.docIdent",
          "IdTipoTelefono": "forms.modificarPersona.idTipoTelefono",
          "Telefono": "forms.modificarPersona.telefono"
        }
      }
    }
  },
  "pages": [
    {
      "id": "modificar-persona",
      "title": "Modificar persona",
      "preloads": [
        {
          "obtenerDatosFormularioModificacionPersona": {
            "IdPersona": "params.personaId"
          }
        }
      ],
      "layout": [
        {
          "type": "container",
          "props": {
            "direction": "column",
            "gap": "lg"
          },
          "children": [
            {
              "type": "heading",
              "props": {
                "text": "Informe de actividad",
                "level": 1
              }
            },
            {
              "type": "heading",
              "props": {
                "text": "Modificar persona",
                "level": 2
              }
            },
            {
              "type": "container",
              "props": {
                "variant": "card",
                "gap": "md"
              },
              "queryStateFeedback": {
                "query": "obtenerDatosFormularioModificacionPersona",
                "states": {
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "skeleton",
                        "props": {
                          "variant": "rect",
                          "height": "400px"
                        }
                      }
                    ]
                  },
                  "error": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "alert",
                        "props": {
                          "title": "Error al cargar los datos de la persona.",
                          "message": "{{queries.obtenerDatosFormularioModificacionPersona.error.message}}",
                          "type": "danger"
                        }
                      }
                    ]
                  }
                }
              },
              "children": [
                {
                  "type": "paragraph",
                  "props": {
                    "text": "* Datos obligatorios"
                  }
                },
                {
                  "type": "form",
                  "id": "modificarPersona",
                  "submitAction": {
                    "type": "executeOperation",
                    "operationName": "modificarPersona"
                  },
                  "children": [
                    {
                      "type": "radioGroup",
                      "props": {
                        "fieldId": "tieneDocumento",
                        "label": "Documento Identificación",
                        "optionLayout": "inline",
                        "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.TieneDocumento",
                        "items": [
                          {
                            "label": "Sí",
                            "value": "true"
                          },
                          {
                            "label": "No",
                            "value": "false"
                          }
                        ]
                      }
                    },
                    {
                      "type": "container",
                      "props": {
                        "direction": "column",
                        "gap": "md"
                      },
                      "visibility": {
                        "reference": "forms.modificarPersona.tieneDocumento",
                        "operator": "equals",
                        "value": "true"
                      },
                      "children": [
                        {
                          "type": "select",
                          "props": {
                            "fieldId": "idTipoDocumento",
                            "label": "Tipo de documento",
                            "placeholder": "Seleccione un tipo",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.IdTipoDocumento",
                            "items": {
                              "source": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.TiposDocumentosIdentificativosDTO",
                              "label": "Nombre",
                              "value": "Id"
                            },
                            "validations": {
                              "required": true
                            }
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "docIdent",
                            "label": "Documento de Identidad",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.DocIdent",
                            "validations": {
                              "required": true
                            }
                          },
                          "visibility": {
                            "reference": "forms.modificarPersona.idTipoDocumento",
                            "operator": "isTruthy"
                          }
                        }
                      ]
                    },
                    {
                      "type": "container",
                      "props": {
                        "direction": "column",
                        "gap": "md"
                      },
                      "children": [
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "nombre",
                            "label": "Nombre",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Nombre",
                            "validations": {
                              "required": true
                            }
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "apellido1",
                            "label": "Primer apellido",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Apellido1",
                            "validations": {
                              "required": true
                            }
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "apellido2",
                            "label": "Segundo apellido",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Apellido2"
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "fechaNacimiento",
                            "label": "Fecha nacimiento",
                            "inputType": "date",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.FechaNacimiento"
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "apodo",
                            "label": "Apodo",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Apodo"
                          }
                        },
                        {
                          "type": "select",
                          "props": {
                            "fieldId": "idPaisNacimiento",
                            "label": "País de Nacimiento",
                            "placeholder": "Seleccione un país",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.IdPaisNacimiento",
                            "items": {
                              "source": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PaisesDTO",
                              "label": "Nombre",
                              "value": "Id"
                            }
                          }
                        },
                        {
                          "type": "select",
                          "props": {
                            "fieldId": "idTipoTelefono",
                            "label": "Tipo de teléfono",
                            "placeholder": "Seleccione un tipo",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.IdTipoTelefono",
                            "items": {
                              "source": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.TiposTelefonoDTO",
                              "label": "Nombre",
                              "value": "Id"
                            }
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "telefono",
                            "label": "Teléfono",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Telefono"
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "email",
                            "label": "Email",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Email"
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "nacionalidad",
                            "label": "Nacionalidad",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Nacionalidad"
                          }
                        },
                        {
                          "type": "input",
                          "props": {
                            "fieldId": "nacionalidad2",
                            "label": "Otra nacionalidad",
                            "defaultValue": "queries.obtenerDatosFormularioModificacionPersona.data.DatosFormularioModificacionPersonaSalidaDTO.PersonaFormularioDTO.Nacionalidad2"
                          }
                        }
                      ]
                    },
                    {
                      "type": "button",
                      "props": {
                        "label": "Guardar →",
                        "color": "primary",
                        "icon": "save"
                      }
                    }
                  ]
                },
                {
                  "type": "container",
                  "props": {
                    "direction": "column",
                    "gap": "sm"
                  },
                  "queryStateFeedback": {
                    "query": "modificarPersona",
                    "states": {
                      "idle": {
                        "mode": "hide"
                      },
                      "loading": {
                        "mode": "fallback",
                        "fallback": [
                          {
                            "type": "skeleton",
                            "props": {
                              "variant": "rect",
                              "height": "8"
                            }
                          }
                        ]
                      },
                      "success": {
                        "mode": "fallback",
                        "fallback": [
                          {
                            "type": "alert",
                            "props": {
                              "title": "Cambios guardados",
                              "message": "La persona se ha actualizado correctamente.",
                              "type": "success"
                            }
                          },
                          {
                            "type": "link",
                            "props": {
                              "label": "Ver ficha",
                              "href": "/carpetaciudadana/detallegenerico.aspx?tram=427&sec=15#/?personaId={{params.personaId}}"
                            }
                          }
                        ]
                      },
                      "error": {
                        "mode": "fallback",
                        "fallback": [
                          {
                            "type": "alert",
                            "props": {
                              "title": "No se pudo guardar",
                              "message": "{{queries.modificarPersona.error.message}}",
                              "type": "danger"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "initialPage": "modificar-persona"
}
