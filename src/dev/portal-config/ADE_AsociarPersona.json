        {
          "obtenerFichaPersonaOrigen": {
            "when": {
              "reference": "params.id_persona",
              "operator": "isTruthy"
            }
          }
        },
        {
          "obtenerFichaHechoDestino": {
            "when": {
              "reference": "params.etiqueta_entidad",
              "operator": "equals",
              "value": "HECHO"
