{
  "api": {
    "buscarPersona": {
      "endpoint": "http://localhost:3000/api/personas/global",
      "method": "POST"
    },
    "buscarVehiculo": {
      "endpoint": "http://localhost:3000/api/vehiculos/global",
      "method": "POST"
    }
  },
  "pages": [
    {
      "id": "home",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Punto de encuentro policial",
            "level": 1
          }
        },
        {
          "type": "container",
          "props": {
            "justify": "center",
            "direction": "row",
            "align": "center"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Consultar personas",
                "action": {
                  "type": "navigateTo",
                  "pageId": "persona"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Consultar vehículos",
                "action": {
                  "type": "navigateTo",
                  "pageId": "vehiculo"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "persona",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Consultar personas",
            "level": 1
          }
        },
        {
          "type": "form",
          "id": "persona-form",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "buscarPersona",
            "body": {
              "dni": "forms.persona-form.documentacion",
              "fuentes": "forms.persona-form.fuentes"
            }
          },
          "children": [
            {
              "type": "container",
              "props": {
                "columns": 12
              },
              "children": [
                {
                  "type": "input",
                  "props": {
                    "fieldId": "documentacion",
                    "label": "Identificación persona"
                  },
                  "layout": {
                    "span": 6
                  }
                },
                {
                  "type": "input",
                  "props": {
                    "inputType": "date",
                    "fieldId": "from",
                    "label": "Desde"
                  },
                  "layout": {
                    "span": 3
                  }
                },
                {
                  "type": "input",
                  "props": {
                    "inputType": "date",
                    "fieldId": "to",
                    "label": "Hasta"
                  },
                  "layout": {
                    "span": 3
                  }
                },
                {
                  "type": "checkboxGroup",
                  "props": {
                    "optionLayout": "inline",
                    "fieldId": "fuentes",
                    "label": "Fuentes",
                    "items": [
                      {
                        "value": "vinfopol",
                        "label": "vinfopol"
                      },
                      {
                        "value": "bites",
                        "label": "bites"
                      },
                      {
                        "value": "multas",
                        "label": "multas"
                      },
                      {
                        "value": "ade",
                        "label": "ade"
                      },
                      {
                        "value": "camaras",
                        "label": "camaras"
                      },
                      {
                        "value": "fichero-intercambio",
                        "label": "fichero-intercambio"
                      },
                      {
                        "value": "circulacion",
                        "label": "circulacion"
                      }
                    ]
                  },
                  "layout": {
                    "span": 12
                  }
                },
                {
                  "type": "button",
                  "props": {
                    "label": "Consultar"
                  },
                  "layout": {
                    "span": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "columns": 12
          },
          "queryStateFeedback": {
            "query": "buscarPersona",
            "states": {
              "idle": {
                "mode": "hide"
              }
            }
          },
          "children": [
            {
              "id": "columnaIzquierda",
              "type": "container",
              "props": {
                "columns": 12
              },
              "layout": {
                "span": 7
              },
              "children": [
                {
                  "id": "foto-estado",
                  "type": "container",
                  "props": {
                    "columns": 1,
                    "gap": "sm"
                  },
                  "layout": {
                    "span": 3
                  },
                  "children": [
                    {
                      "type": "image",
                      "props": {
                        "src": "https://picsum.photos/seed/person/300/400",
                        "alt": "Google logo"
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Busca y captura"
                      }
                    }
                  ]
                },
                {
                  "id": "columna-datos-persona",
                  "type": "container",
                  "props": {
                    "columns": 12,
                    "gap": "sm"
                  },
                  "layout": {
                    "span": 9
                  },
                  "children": [
                    {
                      "type": "heading",
                      "props": {
                        "level": 2,
                        "text": "queries.buscarPersona.data.persona.nombreApellidos"
                      },
                      "layout": {
                        "span": 12
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Documento {{queries.buscarPersona.data.persona.documento}}"
                      },
                      "layout": {
                        "span": 6
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Nacionalidad {{queries.buscarPersona.data.persona.nacionalidad}}"
                      },
                      "layout": {
                        "span": 6
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Fecha de nacimiento ?????"
                      },
                      "layout": {
                        "span": 6
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Domicilio {{queries.buscarPersona.data.persona.direccionActualPadron}}"
                      },
                      "layout": {
                        "span": 6
                      }
                    }
                  ]
                },
                {
                  "type": "repeater",
                  "props": {
                    "items": {
                      "source": "queries.buscarPersona.data.resultados",
                      "key": "fuente.id"
                    },
                    "template": [
                      {
                        "type": "container",
                        "props": {
                          "columns": 12,
                          "gap": "sm",
                          "variant": "card"
                        },
                        "layout": {
                          "span": 3
                        },
                        "children": [
                          {
                            "type": "paragraph",
                            "props": {
                              "text": "{{item.fuente.nombre}}: {{item.total}}"
                            }
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "container",
              "props": {
                "columns": 1
              },
              "layout": {
                "span": 5
              },
              "children": [
                {
                  "type": "image",
                  "props": {
                    "src": "https://picsum.photos/seed/xxxx/700/450",
                    "alt": "Placeholder image"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.vinfopol.datos",
            "operator": "greaterThan",
            "value": 0
          },
          "props": {
            "headers": [
              "Ano",
              "Número",
              "Fecha",
              "Clase",
              "Tipo de Atestado",
              "Resultado",
              "Implicados",
              "Vehículos",
              "Personas",
              "Más info"
            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.vinfopol.datos",
              "cells": [
                "item.anio",
                "item.numero",
                "item.fechaHora",
                "item.clase",
                "item.tipoAtestado",
                "item.resultado",
                "item.implicados",
                "item.vehiculos",
                "item.personas",
                "AÑADIR BOTÓN"
              ]
            },
            "pagination": {
              "enabled": true,
              "pageSize": 2,
              "controls": {
                "variant": "numbered"
              }
            }
          }
        },

        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.bites.datos",
            "operator": "greaterThan",
            "value": 0
          },
          "props": {
            "headers": [
              "Nº Denuncia",
              "Fecha",
              "Matrícula",
              "Normativa",
              "Artículo",
              "Clasificación",
              "Hecho",
              "Ubicación",
              "Descripción",
              "Más info"
            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.bites.datos",
              "cells": [
                "item.numeroDenuncia",
                "item.fechaHora",
                "item.matricula",
                "item.normativa",
                "item.articulo",
                "item.clasificacion",
                "item.tipoHecho",
                "item.ubicacion",
                "item.descripcion",
                "AÑADIR BOTÓN"
              ]
            },
            "pagination": {
              "enabled": true,
              "pageSize": 2,
              "controls": {
                "variant": "numbered"
              }
            }
          }
        },
        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.multas.datos",
            "operator": "greaterThan",
            "value": 0
          },
          "props": {
            "headers": [
              "Expediente",
              "Fecha",
              "Matrícula",
              "Importe",
              "Estado",
              "Hecho",
              "Ubicación",
              "Desc",
              "Más info"
            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.multas.datos",
              "cells": [
                "item.expediente",
                "item.fechaHora",
                "item.matricula",
                "item.importe",
                "item.estado",
                "item.tipoHecho",
                "item.ubicacion",
                "item.descripcion",
                "AÑADIR BOTÓN"
              ]
            },
            "pagination": {
              "enabled": true,
              "pageSize": 2,
              "controls": {
                "variant": "numbered"
              }
            }
          }
        },
        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.ade.datos",
            "operator": "greaterThan",
