              "controls": {
                "variant": "numbered"
              }
            }
          }
        },
        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.circulacion.datos",
            "operator": "greaterThan",
            "value": 0
          },
          "props": {
            "headers": [
              "Matrícula",
              "Marca",
              "Modelo",
              "Bastidor",
              "Propietario",
              "Fecha alta",
              "Ejercicio",
              "Estado impuesto",
              "Importe",
              "Más info"
            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.circulacion.datos",
              "cells": [
                "item.matricula",
                "item.marca",
                "item.modelo",
                "item.bastidor",
                "item.propietarioNombreApellidos",
                "item.fechaAlta",
                "item.impuestoCirculacion.ejercicio",
                "item.impuestoCirculacion.estado",
                "item.impuestoCirculacion.importe",
                "AÑADIR BOTÓN"
              ]
            },
            "pagination": {
