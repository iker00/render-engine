{
  "api": {
    "buscarPersona": {
      "endpoint": "http://localhost:3000/api/personas/12345678A/global",
      "method": "GET"
    },
    "buscarVehiculo": {
      "endpoint": "http://localhost:3000/api/vehiculos/1234ABC/global",
      "method": "GET"
    }
  },
  "pages": [
    {
      "id": "home",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Punto de encuentro policial",
            "level": 1
          }
        },
        {
          "type": "container",
          "props": {
            "justify": "center",
            "direction": "row",
            "align": "center"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Consultar personas 123",
                "action": {
                  "type": "navigateTo",
                  "pageId": "persona"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Consultar vehículos",
                "action": {
                  "type": "navigateTo",
                  "pageId": "vehiculo"
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "direction": "column"
          },
          "children": [
            {
              "type": "heading",
              "props": {
                "text": "Notas",
                "level": 2
              }
            }
          ]
        }
      ]
    },
    {
      "id": "persona",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Consultar personas",
            "level": 1
          }
        },
        {
          "type": "form",
          "id": "persona-form",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "buscarPersona"
          },
          "children": [
            {
              "type": "container",
              "props": {
                "columns": 12
              },
              "children": [
                {
                  "type": "input",
                  "props": {
                    "fieldId": "documentacion",
                    "label": "Identificación persona"
                  },
                  "layout": {
                    "span": 6
                  }
                },
                {
                  "type": "input",
                  "props": {
                    "inputType": "date",
                    "fieldId": "from",
                    "label": "Desde"
                  },
                  "layout": {
                    "span": 3
                  }
                },
                {
                  "type": "input",
                  "props": {
                    "inputType": "date",
                    "fieldId": "to",
                    "label": "Hasta"
                  },
                  "layout": {
                    "span": 3
                  }
                },
                {
                  "type": "checkboxGroup",
                  "props": {
                    "optionLayout": "inline",
                    "fieldId": "fuentes",
                    "label": "Fuentes",
                    "items": [
                      {
                        "value": "vinfopol",
                        "label": "vinfopol"
                      },
                      {
                        "value": "bites",
                        "label": "bites"
                      },
                      {
                        "value": "multas",
                        "label": "multas"
                      },
                      {
                        "value": "ade",
                        "label": "ade"
                      },
                      {
                        "value": "camaras",
                        "label": "camaras"
                      },
                      {
                        "value": "fichero-intercambio",
                        "label": "fichero-intercambio"
                      },
                      {
                        "value": "circulacion",
                        "label": "circulacion"
                      }
                    ]
                  },
                  "layout": {
                    "span": 12
                  }
                },
                {
                  "type": "button",
                  "props": {
                    "label": "Consultar"
                  },
                  "layout": {
                    "span": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "columns": 12
          },
          "queryStateFeedback": {
            "query": "buscarPersona",
            "states": {
              "idle": {
                "mode": "hide"
              }
            }
          },
          "children": [
            {
              "id": "columnaIzquierda",
              "type": "container",
              "props": {
                "columns": 12
              },
              "layout": {
                "span": 7
              },
              "children": [
                {
                  "id": "foto-estado",
                  "type": "container",
                  "props": {
                    "columns": 1,
                    "gap": "sm"
                  },
                  "layout": {
                    "span": 3
                  },
                  "children": [
                    {
                      "type": "image",
                      "props": {
                        "src": "https://picsum.photos/seed/person/300/400",
                        "alt": "Google logo"
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Busca y captura"
                      }
                    }
                  ]
                },
                {
                  "id": "columna-datos-persona",
                  "type": "container",
                  "props": {
                    "columns": 12,
                    "gap": "sm"
                  },
                  "layout": {
                    "span": 9
                  },
                  "children": [
                    {
                      "type": "heading",
                      "props": {
                        "level": 2,
                        "text": "queries.buscarPersona.data.persona.nombreApellidos"
                      },
                      "layout": {
                        "span": 12
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Documento {{queries.buscarPersona.data.persona.documento}}"
                      },
                      "layout": {
                        "span": 6
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Nacionalidad {{queries.buscarPersona.data.persona.nacionalidad}}"
                      },
                      "layout": {
                        "span": 6
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Fecha de nacimiento ?????"
                      },
                      "layout": {
                        "span": 6
                      }
                    },
                    {
                      "type": "paragraph",
                      "props": {
                        "text": "Domicilio {{queries.buscarPersona.data.persona.direccionActualPadron}}"
                      },
                      "layout": {
                        "span": 6
                      }
                    }
                  ]
                },
                {
                  "id": "contadores",
                  "type": "container",
                  "props": {
                    "columns": 12
                  },
                  "layout": {
                    "span": 12
                  },
                  "children": [
                    {
                      "type": "container",
                      "props": {
                        "columns": 12,
                        "gap": "sm",
                        "variant": "card"
                      },
                      "children": [
                        {
                          "type": "paragraph",
                          "props": {
                            "text": "Vinfopol: {{queries.buscarPersona.data.resumen.resumenEstadistico.atestadosJudicialesVinfopol}}"
                          }
                        }
                      ],
                      "layout": {
                        "span": 3
                      }
                    }

                  ]
                }
              ]
            },
            {
              "type": "container",
              "props": {
                "columns": 1
              },
              "layout": {
                "span": 5
              },
              "children": [
                {
                  "type": "image",
                  "props": {
                    "src": "https://picsum.photos/seed/xxxx/700/450",
                    "alt": "Placeholder image"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "vehiculo",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Consultar vehículos",
            "level": 1
          }
        }
      ]
    }
  ],
  "initialPage": "home"
}