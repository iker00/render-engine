              "Matrícula",
              "Estado",
              "Organismo",
              "Hecho",
              "Ubicación",
              "Descripción",
              "Más info"
            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.ade.datos",
              "cells": [
                "item.expediente",
                "item.fechaHora",
                "item.matricula",
                "item.estado",
                "item.organismo",
                "item.tipoHecho",
                "item.ubicacion",
                "item.descripcion",
                "AÑADIR BOTÓN"
              ]
            },
            "pagination": {
              "enabled": true,
              "pageSize": 2,
              "controls": {
                "variant": "numbered"
              }
            }
          }
        },
        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.camaras.datos",
