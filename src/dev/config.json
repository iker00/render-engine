            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.camaras.datos",
              "cells": [
                "item.fechaHora",
                "item.matricula",
                "item.camara",
                "item.ubicacion",
                "item.direccionMarcha",
                "item.confianza",
