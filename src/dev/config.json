              }
            }
          }
        }
      ]
    },
    {
      "id": "vehiculo",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Consultar vehículos",
            "level": 1
          }
        }
      ]
    }
  ],
  "initialPage": "home"
}