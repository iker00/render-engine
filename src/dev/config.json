              }
            }
          }
        },
        {
          "type": "table",
          "visibility": {
            "reference": "queries.buscarPersona.data.resultados.fichero-intercambio.datos",
            "operator": "greaterThan",
            "value": 0
          },
          "props": {
            "headers": [
              "Referencia externa",
              "Fecha",
              "Origen",
              "Matrícula",
              "Hecho",
              "Descripción",
              "Más info"
            ],
            "rows": {
              "source": "queries.buscarPersona.data.resultados.fichero-intercambio.datos",
              "cells": [
                "item.referenciaExterna",
                "item.fechaHora",
                "item.origen",
