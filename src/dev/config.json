{
  "api": {
    "searchUsers": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/posts"
    }
  },
  "pages": [
    {
      "id": "bootstrap-home",
      "preloads": [
        "searchUsers"
      ],
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Bootstrap Home",
            "level": 1
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Development config loaded from the repository."
          }
        },
        {
          "type": "list",
          "props": {
            "items": [
              "Static runtime contract validated before rendering.",
              "Initial page resolved from the active config source.",
              "Page entry preloads can hydrate shared query state on mount."
            ]
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "queries.searchUsers.status"
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Primer post:"
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "queries.searchUsers.data.0.title"
          }
        }
      ]
    }
  ],
  "initialPage": "bootstrap-home"
}
