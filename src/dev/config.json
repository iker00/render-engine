{
  "api": {
    "searchUsers": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/users"
    },
    "searchPosts": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/posts"
    },
    "getPost": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/posts",
      "query": {
        "id": "params.postId"
      }
    },
    "getComments": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/todos"
    }
  },
  "pages": [
    {
      "id": "bootstrap-home",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Home",
            "level": 1
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Contenido del párrafo"
          }
        },
        {
          "type": "list",
          "props": {
            "items": [
              "Static runtime contract validated before rendering.",
              "Initial page resolved from the active config source.",
              "Page entry preloads can hydrate shared query state on mount."
            ]
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Ir a detalles",
                "action": {
                  "type": "navigateTo",
                  "pageId": "details-page"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a ayuda",
                "action": {
                  "type": "navigateTo",
                  "pageId": "help-page"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Buscar posts",
                "action": {
                  "type": "navigateTo",
                  "pageId": "search-posts"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Formulario dinámico",
                "action": {
                  "type": "navigateTo",
                  "pageId": "dynamic-form"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "details-page",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Details Page",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Esta página sirve para probar la navegación declarativa desde el config."
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Volver",
                "action": {
                  "type": "goBack"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a ayuda",
                "action": {
                  "type": "navigateTo",
                  "pageId": "help-page"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "help-page",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Help Page",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Puedes usar estos botones para moverte entre páginas sin cambiar la URL."
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Volver",
                "action": {
                  "type": "goBack"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir al inicio",
                "action": {
                  "type": "navigateTo",
                  "pageId": "bootstrap-home"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "search-posts",
      "preloads": [
        "searchUsers"
      ],
      "layout": [
        {
          "type": "button",
          "props": {
            "label": "Volver",
            "action": {
              "type": "goBack"
            }
          }
        },
        {
          "type": "heading",
          "props": {
            "text": "Search Posts",
            "level": 2
          }
        },
        {
          "type": "form",
          "id": "postForm",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "searchPosts",
            "query": {
              "userId": "forms.postForm.authorId"
            }
          },
          "persistOnUnmount": true,
          "resetOnSuccess": false,
          "children": [
            {
              "type": "select",
              "props": {
                "fieldId": "authorId",
                "label": "Autor",
                "items": {
                  "source": "queries.searchUsers.data",
                  "label": "name",
                  "value": "id"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Limpiar",
                "action": {
                  "type": "resetForm",
                  "formId": "postForm"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Enviar"
              },
              "queryStateFeedback": {
                "query": "searchPosts",
                "states": {
                  "idle": {
                    "mode": "show"
                  },
                  "empty": {
                    "mode": "show"
                  },
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "button",
                        "props": {
                          "label": "Enviando formulario..."
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "repeater",
          "queryStateFeedback": {
            "query": "searchPosts",
            "states": {
              "idle": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "No se ha realizado ninguna búsqueda"
                    }
                  }
                ]
              },
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Cargando..."
                    }
                  }
                ]
              },
              "empty": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "No se han encontrado posts"
                    }
                  }
                ]
              },
              "error": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Ha ocurrido un error al buscar posts"
                    }
                  }
                ]
              }
            }
          },
          "props": {
            "items": {
              "source": "queries.searchPosts.data",
              "key": "id"
            },
            "template": [
              {
                "type": "heading",
                "props": {
                  "text": "item.title",
                  "level": 3
                }
              },
              {
                "type": "paragraph",
                "props": {
                  "text": "item.body"
                }
              },
              {
                "type": "button",
                "props": {
                  "label": "Editar",
                  "action": {
                    "type": "navigateTo",
                    "pageId": "post-form",
                    "params": {
                      "postId": "item.id"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "post-form",
      "preloads": [
        "searchUsers",
        "getPost"
      ],
      "layout": [
        {
          "type": "button",
          "props": {
            "label": "Volver",
            "action": {
              "type": "goBack"
            }
          }
        },
        {
          "type": "heading",
          "props": {
            "text": "Edit",
            "level": 1
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "queryStateFeedback": {
            "query": "searchUsers",
            "states": {
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Loading author options..."
                    }
                  }
                ]
              }
            }
          },
          "children": [
            {
              "type": "form",
              "id": "editPost",
              "persistOnUnmount": false,
              "resetOnSuccess": false,
              "queryStateFeedback": {
                "query": "getPost",
                "states": {
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "paragraph",
                        "props": {
                          "text": "Loading post data..."
                        }
                      }
                    ]
                  }
                }
              },
              "children": [
                {
                  "type": "input",
                  "props": {
                    "fieldId": "title",
                    "label": "Title",
                    "defaultValue": "queries.getPost.data.0.title"
                  }
                },
                {
                  "type": "input",
                  "props": {
                    "fieldId": "body",
                    "label": "Body",
                    "defaultValue": "queries.getPost.data.0.body"
                  }
                },
                {
                  "type": "select",
                  "props": {
                    "fieldId": "userId",
                    "label": "Author",
                    "items": {
                      "source": "queries.searchUsers.data",
                      "label": "name",
                      "value": "id"
                    },
                    "defaultValue": "queries.getPost.data.0.userId"
                  }
                },
                {
                  "type": "button",
                  "props": {
                    "label": "Submit"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "dynamic-form",
      "layout": [
        {
          "type": "button",
          "props": {
            "label": "Volver",
            "action": {
              "type": "goBack"
            }
          }
        },
        {
          "type": "heading",
          "props": {
            "text": "Dynamic form example",
            "level": 1
          }
        },
        {
          "type": "form",
          "id": "dynamicForm",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "searchPosts"
          },
          "children": [
            {
              "type": "input",
              "props": {
                "fieldId": "name",
                "label": "Name",
                "validations": {
                  "required": true,
                  "minLength": 3,
                  "maxLength": 10
                }
              }
            },
            {
              "type": "input",
              "props": {
                "inputType": "email",
                "fieldId": "email",
                "label": "Email",
                "validations": {
                  "required": true,
                  "maxLength": 15
                }
              }
            },
            {
              "type": "radioGroup",
              "props": {
                "fieldId": "clientType",
                "label": "Tipo de cliente",
                "items": [
                  {
                    "label": "Particular",
                    "value": "particular"
                  },
                  {
                    "label": "Empresa",
                    "value": "empresa"
                  }
                ],
                "defaultValue": "particular"
              }
            },
            {
              "type": "checkboxGroup",
              "props": {
                "fieldId": "checkboxExample",
                "label": "Checkbox example",
                "items": [
                  {
                    "label": "Item 1",
                    "value": "item1"
                  },
                  {
                    "label": "Item 2",
                    "value": "item2"
                  },
                  {
                    "label": "Item 3",
                    "value": "item3"
                  },
                  {
                    "label": "Item 4",
                    "value": "item4"
                  },
                  {
                    "label": "Item 5",
                    "value": "item5"
                  },
                  {
                    "label": "Item 6",
                    "value": "item6"
                  }
                ],
                "defaultValue": [
                  "item1",
                  "item2"
                ],
                "validations": {
                  "required": true,
                  "minSelections": 2,
                  "maxSelections": 3
                }
              }
            },
            {
              "type": "input",
              "props": {
                "inputType": "number",
                "fieldId": "number",
                "label": "Número",
                "validations": {
                  "required": true,
                  "min": 1,
                  "max": 100
                }
              }
            },
            {
              "type": "heading",
              "props": {
                "text": "Datos personales",
                "level": 2
              },
              "visibility": {
                "reference": "forms.dynamicForm.clientType",
                "operator": "equals",
                "value": "particular"
              }
            },
            {
              "type": "input",
              "props": {
                "fieldId": "personal.dni",
                "label": "DNI"
              },
              "visibility": {
                "reference": "forms.dynamicForm.clientType",
                "operator": "equals",
                "value": "particular"
              }
            },
            {
              "type": "input",
              "props": {
                "inputType": "date",
                "fieldId": "personal.nacimiento",
                "label": "Fecha de nacimiento"
              },
              "visibility": {
                "reference": "forms.dynamicForm.clientType",
                "operator": "equals",
                "value": "particular"
              }
            },
            {
              "type": "select",
              "props": {
                "fieldId": "personal.estadoCivil",
                "label": "Estado civil",
                "items": [
                  {
                    "label": "Soltero",
                    "value": "soltero"
                  },
                  {
                    "label": "Casado",
                    "value": "casado"
                  },
                  {
                    "label": "Divorciado",
                    "value": "divorciado"
                  }
                ]
              },
              "visibility": {
                "reference": "forms.dynamicForm.clientType",
                "operator": "equals",
                "value": "particular"
              }
            },
            {
              "type": "heading",
              "props": {
                "text": "Datos de la empresa",
                "level": 2
              },
              "visibility": {
                "reference": "forms.dynamicForm.clientType",
                "operator": "equals",
                "value": "empresa"
              }
            },
            {
              "type": "input",
              "props": {
                "fieldId": "company.cif",
                "label": "CIF",
                "validations": {
                  "required": true,
                  "minLength": 9,
                  "maxLength": 9
                }
              },
              "visibility": {
                "reference": "forms.dynamicForm.clientType",
                "operator": "equals",
                "value": "empresa"
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Submit"
              }
            }
          ]
        }
      ]
    }
  ],
  "initialPage": "bootstrap-home"
}
