{
  "api": {
    "searchUsers": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/users"
    },
    "searchPosts": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/posts"
    },
    "getPost": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/posts",
      "query": {
        "id": "params.postId"
      }
    }
  },
  "pages": [
    {
      "id": "bootstrap-home",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Bootstrap Home",
            "level": 1
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Contenido del párrafo"
          }
        },
        {
          "type": "list",
          "props": {
            "items": [
              "Static runtime contract validated before rendering.",
              "Initial page resolved from the active config source.",
              "Page entry preloads can hydrate shared query state on mount."
            ]
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Ir a detalles",
                "action": {
                  "type": "navigateTo",
                  "pageId": "details-page"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a ayuda",
                "action": {
                  "type": "navigateTo",
                  "pageId": "help-page"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Buscar posts",
                "action": {
                  "type": "navigateTo",
                  "pageId": "search-posts"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Editar post",
                "action": {
                  "type": "navigateTo",
                  "pageId": "post-form",
                  "params": {
                    "postId": "56"
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "details-page",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Details Page",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Esta página sirve para probar la navegación declarativa desde el config."
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Volver",
                "action": {
                  "type": "goBack"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a ayuda",
                "action": {
                  "type": "navigateTo",
                  "pageId": "help-page"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "help-page",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Help Page",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Puedes usar estos botones para moverte entre páginas sin cambiar la URL."
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Volver",
                "action": {
                  "type": "goBack"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir al inicio",
                "action": {
                  "type": "navigateTo",
                  "pageId": "bootstrap-home"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "search-posts",
      "preloads": [
        "searchUsers"
      ],
      "layout": [
        {
          "type": "button",
          "props": {
            "label": "Volver",
            "action": {
              "type": "goBack"
            }
          }
        },
        {
          "type": "heading",
          "props": {
            "text": "Search Posts",
            "level": 2
          }
        },
        {
          "type": "form",
          "id": "postForm",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "searchPosts",
            "query": {
              "userId": "forms.postForm.authorId"
            }
          },
          "resetOnSuccess": false,
          "children": [
            {
              "type": "input",
              "props": {
                "fieldId": "id",
                "label": "Post ID"
              }
            },
            {
              "type": "paragraph",
              "visibility": {
                "reference": "forms.postForm.id",
                "operator": "notEquals",
                "value": "10"
              },
              "props": {
                "text": "El número no es 10"
              }
            },
            {
              "type": "select",
              "props": {
                "fieldId": "authorId",
                "label": "Autor",
                "items": {
                  "source": "queries.searchUsers.data",
                  "label": "name",
                  "value": "id"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Limpiar",
                "action": {
                  "type": "resetForm",
                  "formId": "postForm"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Enviar"
              },
              "queryStateFeedback": {
                "query": "searchPosts",
                "states": {
                  "idle": {
                    "mode": "show"
                  },
                  "empty": {
                    "mode": "show"
                  },
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "button",
                        "props": {
                          "label": "Enviando formulario..."
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "queryStateFeedback": {
            "query": "searchPosts",
            "states": {
              "idle": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "No se ha llamado a la API,"
                    }
                  }
                ]
              },
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Buscando posts..."
                    }
                  }
                ]
              },
              "error": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Error al buscar posts"
                    }
                  }
                ]
              },
              "empty": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "No se han encontrado posts"
                    }
                  }
                ]
              }
            }
          },
          "children": [
            {
              "type": "paragraph",
              "props": {
                "text": "Posts encontrados:"
              }
            },
            {
              "type": "list",
              "props": {
                "items": {
                  "source": "queries.searchPosts.data",
                  "itemText": "title"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "post-form",
      "preloads": [
        "getPost",
        "searchUsers"
      ],
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Edit",
            "level": 1
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "queryStateFeedback": {
            "query": "searchUsers",
            "states": {
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Loading author options..."
                    }
                  }
                ]
              }
            }
          },
          "children": [
            {
              "type": "form",
              "id": "editPost",
              "resetOnSuccess": false,
              "queryStateFeedback": {
                "query": "getPost",
                "states": {
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "paragraph",
                        "props": {
                          "text": "Loading post data..."
                        }
                      }
                    ]
                  }
                }
              },
              "children": [
                {
                  "type": "input",
                  "props": {
                    "fieldId": "title",
                    "label": "Title",
                    "defaultValue": "queries.getPost.data.0.title"
                  }
                },
                {
                  "type": "input",
                  "props": {
                    "fieldId": "body",
                    "label": "Body",
                    "defaultValue": "queries.getPost.data.0.body"
                  }
                },
                {
                  "type": "select",
                  "props": {
                    "fieldId": "userId",
                    "label": "Author",
                    "items": {
                      "source": "queries.searchUsers.data",
                      "label": "name",
                      "value": "id"
                    },
                    "defaultValue": "queries.getPost.data.0.userId"
                  }
                },
                {
                  "type": "button",
                  "props": {
                    "label": "Submit"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "initialPage": "bootstrap-home"
}
