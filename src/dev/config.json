{
  "api": {
    "searchUsers": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/users"
    },
    "searchPosts": {
      "method": "GET",
      "endpoint": "https://jsonplaceholder.typicode.com/posts"
    },
    "createUser": {
      "method": "POST",
      "endpoint": "https://jsonplaceholder.typicode.com/users",
      "body": {
        "name": "forms.userForm.name",
        "email": "forms.userForm.email"
      }
    }
  },
  "pages": [
    {
      "id": "bootstrap-home",
      "preloads": [
        "searchPosts"
      ],
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Bootstrap Home",
            "level": 1
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Development config loaded from the repository."
          }
        },
        {
          "type": "list",
          "props": {
            "items": [
              "Static runtime contract validated before rendering.",
              "Initial page resolved from the active config source.",
              "Page entry preloads can hydrate shared query state on mount."
            ]
          }
        },
        {
          "type": "heading",
          "props": {
            "text": "Posts",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "queryStateFeedback": {
            "query": "searchPosts",
            "states": {
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Loading posts..."
                    }
                  }
                ]
              }
            }
          },
          "props": {
            "text": "Primer post:"
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "queries.searchPosts.data.0.title"
          }
        },
        {
          "type": "heading",
          "props": {
            "text": "Users",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "queryStateFeedback": {
            "query": "searchUsers",
            "states": {
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Loading users..."
                    }
                  }
                ]
              },
              "error": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Could not load users."
                    }
                  }
                ]
              },
              "empty": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "No users found."
                    }
                  }
                ]
              },
              "success": {
                "mode": "show"
              }
            }
          },
          "props": {
            "text": "Users loaded successfully."
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "queries.searchUsers.data.0.name"
          }
        },
        {
          "type": "button",
          "props": {
            "label": "Search users",
            "action": {
              "type": "executeOperation",
              "operationName": "searchUsers"
            }
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Ir a detalles",
                "action": {
                  "type": "navigateTo",
                  "pageId": "details-page"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a ayuda",
                "action": {
                  "type": "navigateTo",
                  "pageId": "help-page"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a formulario",
                "action": {
                  "type": "navigateTo",
                  "pageId": "bootstrap-form"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "details-page",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Details Page",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Esta página sirve para probar la navegación declarativa desde el config."
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Volver",
                "action": {
                  "type": "goBack"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir a ayuda",
                "action": {
                  "type": "navigateTo",
                  "pageId": "help-page"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "help-page",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Help Page",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "props": {
            "text": "Puedes usar estos botones para moverte entre páginas sin cambiar la URL."
          }
        },
        {
          "type": "container",
          "props": {
            "gap": "sm"
          },
          "children": [
            {
              "type": "button",
              "props": {
                "label": "Volver",
                "action": {
                  "type": "goBack"
                }
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Ir al inicio",
                "action": {
                  "type": "navigateTo",
                  "pageId": "bootstrap-home"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "bootstrap-form",
      "layout": [
        {
          "type": "heading",
          "props": {
            "text": "Bootstrap Form",
            "level": 2
          }
        },
        {
          "type": "paragraph",
          "queryStateFeedback": {
            "query": "createUser",
            "states": {
              "loading": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Enviando formulario..."
                    }
                  }
                ]
              },
              "success": {
                "mode": "show"
              },
              "error": {
                "mode": "fallback",
                "fallback": [
                  {
                    "type": "paragraph",
                    "props": {
                      "text": "Error al enviar el formulario."
                    }
                  }
                ]
              }
            }
          },
          "props": {
            "text": "¡Formulario enviado correctametne!"
          }
        },
        {
          "type": "form",
          "id": "userForm",
          "submitAction": {
            "type": "executeOperation",
            "operationName": "createUser"
          },
          "resetOnSuccess": true,
          "children": [
            {
              "type": "input",
              "props": {
                "fieldId": "name",
                "label": "Name",
                "defaultValue": "John Doe"
              }
            },
            {
              "type": "input",
              "props": {
                "fieldId": "email",
                "label": "Email",
                "defaultValue": "john.doe@example.com",
                "required": true
              }
            },
            {
              "type": "button",
              "props": {
                "label": "Submit"
              },
              "queryStateFeedback": {
                "query": "createUser",
                "states": {
                  "loading": {
                    "mode": "fallback",
                    "fallback": [
                      {
                        "type": "button",
                        "props": {
                          "label": "Enviando formulario..."
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "initialPage": "bootstrap-home"
}
