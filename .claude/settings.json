{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/scripts/block-config-edit.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/scripts/block-no-verify.js"
          }
        ]
      },
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/scripts/block-wait-loop.js"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "implement-task",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/implement-task-test-first/hooks/load-context.js"
          }
        ]
      },
      {
        "matcher": "review-plan",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/review-implementation-plan/hooks/check-tasks-context.js"
          }
        ]
      },
      {
        "matcher": "review-task",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/implement-task-test-first/hooks/review-task-context.js"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implement-task",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/implement-task-test-first/hooks/validate.js",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "plan-feature|plan-feature-trivial",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/generate-implementation-plan/hooks/validate-tasks.js",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "implement-feature",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/implement-task-test-first/hooks/validate-coverage.js",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "review-task",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/ai-workflow/skills/implement-task-test-first/hooks/count-review.js"
          }
        ]
      }
    ]
  }
}
